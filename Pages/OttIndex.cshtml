@page "/ottindex"
@model OttIndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTT Multi-View — 넷플릭스·유튜브 4분할 동시 시청 Windows 앱 | domang</title>
    <meta name="description" content="넷플릭스, 유튜브, 디즈니+ 등 OTT를 최대 4개까지 한 화면에서 동시에 보는 무료 Windows 데스크톱 앱. PiP, 레이아웃 저장, 칸별 음량 조절을 지원합니다." />
    <!-- 검색엔진·공유 미리보기: 대표 주소 / Open Graph / 트위터 카드 / 구조화 데이터 -->
    <link rel="canonical" href="https://domang.org/ottindex" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="domang" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content="https://domang.org/ottindex" />
    <meta property="og:title" content="OTT Multi-View — 넷플릭스·유튜브 4분할 동시 시청 Windows 앱 | domang" />
    <meta property="og:description" content="넷플릭스, 유튜브, 디즈니+ 등 OTT를 최대 4개까지 한 화면에서 동시에 보는 무료 Windows 데스크톱 앱. PiP, 레이아웃 저장, 칸별 음량 조절을 지원합니다." />
    <meta property="og:image" content="https://domang.org/img/og/ott.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="OTT Multi-View — 넷플릭스·유튜브 4분할 동시 시청 Windows 앱 | domang" />
    <meta name="twitter:description" content="넷플릭스, 유튜브, 디즈니+ 등 OTT를 최대 4개까지 한 화면에서 동시에 보는 무료 Windows 데스크톱 앱. PiP, 레이아웃 저장, 칸별 음량 조절을 지원합니다." />
    <meta name="twitter:image" content="https://domang.org/img/og/ott.jpg" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "SoftwareApplication",
      "name": "OTT Multi-View",
      "url": "https://domang.org/ottindex",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Windows",
      "inLanguage": "ko",
      "author": {
        "@@type": "Person",
        "name": "안도영",
        "url": "https://domang.org/",
        "sameAs": [
          "https://github.com/andomang"
        ]
      },
      "downloadUrl": "https://github.com/andomang/OTT/releases",
      "description": "넷플릭스, 유튜브, 디즈니+ 등 OTT를 최대 4개까지 한 화면에서 동시에 보는 무료 Windows 데스크톱 앱. PiP, 레이아웃 저장, 칸별 음량 조절을 지원합니다.",
      "image": "https://domang.org/img/og/ott.jpg"
    }
    </script>
    <!-- 파비콘 -->
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- 테마: 저장된 선택이 있으면 그리기 전에 바로 적용 (깜빡임 방지). 없으면 기기 설정을 따름 -->
    <script>
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <!-- 본문 글꼴: Pretendard (메인 포트폴리오와 같음) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- 소개 페이지 공통 스타일 (흰 바탕 편집 디자인, 다크 모드 포함) -->
    <link rel="stylesheet" href="/css/project.css" asp-append-version="true" />
    <style>
        /* 4분할 화면 구성 그림 (실제 캡처가 아니라 설명용) */
        .layout-svg { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; background: var(--tint); }
        .layout-svg .pane { fill: var(--paper); stroke: var(--rule); }
        .layout-svg .bar { fill: var(--paper); stroke: var(--rule); }
        .layout-svg .ink { fill: var(--ink); }
        .layout-svg .mute { fill: var(--ink-3); }
        .layout-svg .acc { fill: var(--accent); }
        .layout-svg .line { stroke: var(--ink-3); stroke-width: 2; fill: none; stroke-linecap: round; }
        .layout-svg text { font: 600 15px "Pretendard Variable", Pretendard, sans-serif; }
        .layout-svg .small { font-size: 12px; font-weight: 500; }
    </style>
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body class="p-ott">
    <script>document.documentElement.classList.add('js');</script>
    <!-- 광고: 넓은 화면(1290px 이상)에서 본문 양옆 고정 -->
    <aside class="ad-side ad-left" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <aside class="ad-side ad-right" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <div class="wrap">
        <!-- 상단: 포트폴리오로 / 테마 전환 / 바로가기 -->
        <header class="topbar">
            <a href="/" class="back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>domang.org</a>
            <div class="top-actions">
                <button type="button" class="theme-btn" id="themeBtn" aria-label="다크 모드로 바꾸기">
                    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
                <a href="https://github.com/andomang/OTT/releases" class="go" target="_blank" rel="noopener">GitHub에서 받기<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg></a>
            </div>
        </header>

        <main>
            <!-- 첫 화면: 제목 / 한 문단 / 상태 -->
            <section class="hero">
                <h1>OTT Multi-View</h1>
                <p class="lede">넷플릭스·유튜브·디즈니+ 같은 OTT를 최대 4개까지 한 화면에서 동시에 보는 Windows 데스크톱 앱입니다. 칸마다 따로 조작하고, PiP와 레이아웃 저장을 지원합니다.</p>
                <div class="facts"><span class="status"><span class="dot off"></span>Windows 앱</span><span>2026</span><span>GitHub Releases 배포</span></div>
            </section>

            <!-- 화면 구성 그림: 데스크톱 앱이라 웹 캡처가 없어 직접 그린 설명용 그림 -->
            <figure class="shot">
                <div class="frame">
                    <div class="chrome" aria-hidden="true"><i><b></b><b></b><b></b></i><span>OTT Multi-View</span></div>
                    <svg class="layout-svg" viewBox="0 0 640 400" role="img" aria-label="화면을 넷으로 나눠 넷플릭스·유튜브·디즈니+·티빙을 동시에 보고, 한 칸만 소리를 켠 모습">
                        <rect class="bar" x="16" y="14" width="608" height="30" rx="6" />
                        <text class="ink small" x="30" y="34">레이아웃: 2 × 2</text>
                        <text class="mute small" x="520" y="34">레이아웃 저장</text>
                        <rect class="pane" x="16" y="56" width="296" height="160" rx="8" /><text class="ink" x="34" y="88">넷플릭스</text><path class="acc" d="M152 120 l30 17 -30 17z" /><text class="mute small" x="34" y="198">음량</text><rect class="mute" x="70" y="192" width="120" height="4" rx="2" opacity=".35" /><rect class="acc" x="70" y="192" width="96" height="4" rx="2" />
                        <rect class="pane" x="328" y="56" width="296" height="160" rx="8" /><text class="ink" x="346" y="88">유튜브</text><path class="mute" d="M464 120 l30 17 -30 17z" /><text class="mute small" x="346" y="198">음량</text><rect class="mute" x="382" y="192" width="120" height="4" rx="2" opacity=".35" /><rect class="mute" x="382" y="192" width="0" height="4" rx="2" />
                        <rect class="pane" x="16" y="226" width="296" height="160" rx="8" /><text class="ink" x="34" y="258">디즈니+</text><path class="mute" d="M152 290 l30 17 -30 17z" /><text class="mute small" x="34" y="368">음량</text><rect class="mute" x="70" y="362" width="120" height="4" rx="2" opacity=".35" /><rect class="mute" x="70" y="362" width="0" height="4" rx="2" />
                        <rect class="pane" x="328" y="226" width="296" height="160" rx="8" /><text class="ink" x="346" y="258">티빙</text><path class="mute" d="M464 290 l30 17 -30 17z" /><text class="mute small" x="346" y="368">음량</text><rect class="mute" x="382" y="362" width="120" height="4" rx="2" opacity=".35" /><rect class="mute" x="382" y="362" width="0" height="4" rx="2" />
                    </svg>
                </div>
                <figcaption>4분할 화면 구성 (설명용 그림이며 실제 캡처가 아닙니다). 소리는 한 칸만 켜고 나머지는 음소거하는 식으로 씁니다.</figcaption>
            </figure>

            <!-- 주요 기능 -->
            <section class="block">
                <h2>주요 기능</h2>
                <div>
                    <ul class="feats">
                        <li><h3>멀티뷰 (최대 4분할)</h3><p>화면을 1~4개로 분할하여 서로 다른 OTT를 동시에 시청합니다. 드래그로 칸 위치를 교체할 수 있습니다.</p></li>
                        <li><h3>PiP (Picture-in-Picture)</h3><p>선택한 화면을 항상 위 작은 창으로 분리합니다. 다른 작업을 하면서도 영상을 계속 볼 수 있습니다.</p></li>
                        <li><h3>개별 음량 조절 &amp; 음소거</h3><p>각 화면의 음량을 독립적으로 조절하고 음소거할 수 있습니다. 하나만 소리를 키우고 나머지는 음소거하는 식으로 사용합니다.</p></li>
                        <li><h3>레이아웃 저장 &amp; 복원</h3><p>현재 열어둔 OTT 조합과 화면 분할 비율을 저장해두고, 다음 접속 시 한 번에 복원합니다.</p></li>
                        <li><h3>회원 시스템</h3><p>로그인·회원가입·닉네임 변경·비밀번호 변경·통계 확인 기능을 내장합니다. 회원 정보는 Google Apps Script 서버를 거쳐 저장되고, 앱은 로그인 때 받은 토큰으로만 요청합니다.</p></li>
                        <li><h3>OTT 계정 보안</h3><p>넷플릭스·유튜브 등의 OTT 계정 정보는 서버에 일절 저장되지 않습니다. 로그인 세션은 사용자 PC 내부 드라이브에 WebView2 쿠키로만 저장되며, 외부로 전송되지 않습니다. 앱을 삭제하면 쿠키도 함께 제거됩니다.</p></li>
                    </ul>
                </div>
            </section>

            <!-- 광고: 본문 중간 (버튼·링크와 떨어진 자리) -->
            <div class="ad-mid"><partial name="_AdUnit" model='@("inline")' /></div>

            <!-- 기술 -->
            <section class="block">
                <h2>기술</h2>
                <div>
                    <table class="stack">
                        <tr><th scope="row">앱</th><td>C# WinForms · .NET 8 · WebView2</td></tr>
                        <tr><th scope="row">서버</th><td>Google Apps Script · Google Sheets</td></tr>
                        <tr><th scope="row">배포</th><td>GitHub Releases</td></tr>
                        <tr><th scope="row">환경</th><td>Windows 10 이상 · WebView2 런타임 필요</td></tr>
                    </table>
                </div>
            </section>

            <!-- 광고: 본문 끝(기술 소개)과 '열기' 버튼 구역 사이 — 링크·버튼에 붙지 않게 위아래 여백 + 구분선 -->
            <div class="ad-mid"><partial name="_AdUnit" model='@("inline")' /></div>
            <!-- 직접 써 보기 -->
            <section class="cta">
                <p>Windows에서 바로 써 보세요.</p>
                <a href="https://github.com/andomang/OTT/releases" class="go big" target="_blank" rel="noopener">GitHub에서 받기<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg></a>
            </section>

            <!-- 다른 프로젝트로 바로 이동 -->
            <nav class="others" aria-label="다른 프로젝트">
                <h2>다른 프로젝트</h2>
                <ul>
                    <li><a href="/metaindex"><b>Meta Search</b><span>통합 검색엔진<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a></li>
                    <li><a href="/pokeindex"><b>포켓몬스터 아스테라</b><span>브라우저 팬게임<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a></li>
                    <li><a href="/driveindex"><b>Cloud Drive</b><span>개인 클라우드 드라이브<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a></li>
                </ul>
            </nav>

        </main>

        <!-- 연락처 & 저작권 -->
        <footer class="fine">
            <span>&copy; 2026 안도영 · <a href="mailto:metasearch@@domang.org">metasearch@@domang.org</a> · 010-2583-1894</span>
            <a href="/Privacy" class="u">개인정보처리방침</a>
        </footer>
    </div>
    <script src="/js/theme.js" asp-append-version="true"></script>
</body>
</html>
