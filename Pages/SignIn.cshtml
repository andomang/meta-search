@page "/signin"
@model SignInModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>domang 로그인</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- 테마: 저장된 선택이 있으면 그리기 전에 바로 적용 (깜빡임 방지) -->
    <script>
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- 메인·소개 페이지와 같은 색·글꼴 + 통합 계정 창 -->
    <link rel="stylesheet" href="/css/project.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
    <style>
        /* 가운데 한 덩어리만 있는 페이지 */
        .signin { max-width: 440px; margin: 0 auto; padding-block: clamp(16px, 6vh, 64px) 48px; }
        .me { display: grid; gap: 14px; padding: 26px 24px; }
        .me h1 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.03em; }
        .me p { color: var(--ink-2); }
        .me b { color: var(--ink); }
        .me .row { display: flex; gap: 8px; flex-wrap: wrap; }
        .me .ghost { background: transparent; color: var(--ink); border: 1px solid var(--rule); height: 34px; padding: 0 16px; border-radius: 999px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
        .me .ghost:hover { border-color: var(--ink); }
    </style>
</head>
<body>
    <div class="wrap">
        <header class="topbar">
            <a href="/" class="back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>domang.org</a>
            <div class="top-actions">
                <button type="button" class="theme-btn" id="themeBtn" aria-label="다크 모드로 바꾸기">
                    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
            </div>
        </header>

        <main class="signin">
            @if (Model.UserId != null)
            {
                <!-- 이미 로그인한 경우 -->
                <section class="me da-inline">
                    <h1>로그인되어 있어요</h1>
                    <p><b>@Model.UserName</b> (@Model.UserId) 님으로 로그인 중입니다.</p>
                    <div class="row">
                        <a class="go" href="@Model.ReturnUrl">계속하기</a>
                        <button type="button" class="ghost" id="logout">로그아웃</button>
                    </div>
                </section>
            }
            else
            {
                <!-- 로그인·회원가입·계정 찾기 (auth.js가 채움) -->
                <section id="auth"><noscript>로그인하려면 자바스크립트를 켜 주세요.</noscript></section>
            }
        </main>
    </div>
    <script src="/js/theme.js" asp-append-version="true"></script>
    <script src="/js/auth.js" asp-append-version="true"></script>
    <script>
        // 로그인·가입 후 돌아갈 주소 (서버에서 같은 사이트 경로만 허용해 넘겨줌)
        var back = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReturnUrl));
        var box = document.getElementById('auth');
        if (box) DomangAuth.mount(box, { view: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.View)), onDone: function () { location.href = back; } });
        var lo = document.getElementById('logout');
        if (lo) lo.addEventListener('click', function () {
            fetch('/api/astera/logout', { method: 'POST', credentials: 'same-origin' }).then(function () { location.reload(); });
        });
    </script>
</body>
</html>
