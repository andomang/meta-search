@page "/pokeindex"
@model PokeIndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>포켓몬스터 아스테라 — 브라우저에서 바로 하는 오리지널 스토리 팬게임 | domang</title>
    <meta name="description" content="신대륙 아스테라를 무대로 한 오리지널 스토리 팬게임. 설치 없이 PC·모바일 브라우저에서 바로 플레이하고, 진행 기록은 domang 계정에 저장됩니다." />
    <!-- 검색엔진·공유 미리보기: 대표 주소 / Open Graph / 트위터 카드 / 구조화 데이터 -->
    <link rel="canonical" href="https://domang.org/pokeindex" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="domang" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content="https://domang.org/pokeindex" />
    <meta property="og:title" content="포켓몬스터 아스테라 — 브라우저에서 바로 하는 오리지널 스토리 팬게임 | domang" />
    <meta property="og:description" content="신대륙 아스테라를 무대로 한 오리지널 스토리 팬게임. 설치 없이 PC·모바일 브라우저에서 바로 플레이하고, 진행 기록은 domang 계정에 저장됩니다." />
    <meta property="og:image" content="https://domang.org/img/og/pokemon.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="포켓몬스터 아스테라 — 브라우저에서 바로 하는 오리지널 스토리 팬게임 | domang" />
    <meta name="twitter:description" content="신대륙 아스테라를 무대로 한 오리지널 스토리 팬게임. 설치 없이 PC·모바일 브라우저에서 바로 플레이하고, 진행 기록은 domang 계정에 저장됩니다." />
    <meta name="twitter:image" content="https://domang.org/img/og/pokemon.jpg" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "VideoGame",
      "name": "포켓몬스터 아스테라",
      "url": "https://domang.org/pokemon",
      "gamePlatform": [
        "Web browser",
        "PC",
        "Mobile"
      ],
      "genre": "RPG",
      "playMode": "SinglePlayer",
      "inLanguage": "ko",
      "author": {
        "@@type": "Person",
        "name": "안도영",
        "url": "https://domang.org/",
        "sameAs": [
          "https://github.com/andomang"
        ]
      },
      "description": "신대륙 아스테라를 무대로 한 오리지널 스토리 팬게임. 설치 없이 PC·모바일 브라우저에서 바로 플레이하고, 진행 기록은 domang 계정에 저장됩니다.",
      "image": "https://domang.org/img/og/pokemon.jpg"
    }
    </script>
    <!-- 파비콘 -->
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- 테마: 저장된 선택이 있으면 그리기 전에 바로 적용 (깜빡임 방지). 없으면 기기 설정을 따름 -->
    <script>
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <!-- 본문 글꼴: Pretendard (메인 포트폴리오와 같음) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- 소개 페이지 공통 스타일 (흰 바탕 편집 디자인, 다크 모드 포함) -->
    <link rel="stylesheet" href="/css/project.css" asp-append-version="true" />
    <style>
        /* 출현 정보: 확률 요약은 항상 보이고, 지역별 표는 접어 둠 */
        .enc-rules { display: grid; }
        .enc-rule { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; padding-block: 12px; border-top: 1px solid var(--rule); font-size: 14px; }
        .enc-rule:first-child { border-top: 0; padding-top: 0; }
        .enc-rule span { font-weight: 700; color: var(--accent); }
        .enc-rule p { color: var(--ink-2); min-width: 0; }
        .enc-rule b, .enc-lg b, .enc-map summary b { color: var(--ink); }
        .enc-all { margin-top: 20px; border-top: 2px solid var(--rule-strong); }
        .enc-all > summary {
            cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 12px;
            padding-block: 16px; font-weight: 700;
        }
        .enc-all > summary::-webkit-details-marker, .enc-map summary::-webkit-details-marker { display: none; }
        .enc-all > summary em { font-style: normal; font-weight: 500; font-size: 13px; color: var(--ink-3); display: inline-flex; align-items: center; gap: 8px; }
        .enc-all > summary em::after { content: "+"; font-size: 18px; line-height: 1; color: var(--ink); transition: transform .3s cubic-bezier(.16, 1, .3, 1); }
        .enc-all[open] > summary em::after { transform: rotate(45deg); }
        .enc-all > summary:hover { color: var(--accent); }
        .enc-map { border-top: 1px solid var(--rule); }
        .enc-map summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding-block: 12px; }
        .enc-map summary b { font-size: 15px; }
        .enc-map summary em { font-style: normal; font-size: 12.5px; color: var(--ink-3); text-align: right; font-variant-numeric: tabular-nums; }
        .enc-map summary:hover b { color: var(--accent); }
        .enc-map[open] { padding-bottom: 8px; }
        .enc-h { font-size: 12.5px; font-weight: 700; color: var(--ink-2); margin: 6px 0 8px; }
        .enc-p { font-size: 13.5px; color: var(--ink-2); margin-bottom: 12px; }
        .chips { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-bottom: 12px; font-size: 13.5px; }
        .chip i { font-style: normal; color: var(--ink-3); font-variant-numeric: tabular-nums; margin-left: 2px; }
        .enc-lg { list-style: none; display: grid; gap: 8px; margin-bottom: 12px; }
        .enc-lg li { font-size: 13.5px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
        .enc-lg small { flex-basis: 100%; color: var(--ink-3); font-size: 12.5px; }
        .enc-lg .k { font-size: 11.5px; font-weight: 700; color: var(--accent); }
        .enc-lg .k.myth { color: var(--ink-2); }
        .enc-lg .k::after { content: " ·"; color: var(--ink-3); }
        @@media (max-width: 640px) { .enc-rule { grid-template-columns: 1fr; gap: 2px; } }
    </style>
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body class="p-poke">
    <script>document.documentElement.classList.add('js');</script>
    <!-- 광고: 넓은 화면(1290px 이상)에서 본문 양옆 고정 -->
    <aside class="ad-side ad-left" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <aside class="ad-side ad-right" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <div class="wrap">
        <!-- 상단: 포트폴리오로 / 테마 전환 / 바로가기 -->
        <header class="topbar">
            <a href="/" class="back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>domang.org</a>
            <div class="top-actions">
                <button type="button" class="theme-btn" id="themeBtn" aria-label="다크 모드로 바꾸기">
                    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
                <a href="/pokemon" class="go">게임 플레이<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
            </div>
        </header>

        <main>
            <!-- 첫 화면: 제목 / 한 문단 / 상태 -->
            <section class="hero">
                <h1>포켓몬스터 <em>아스테라</em></h1>
                <p class="lede">200년 전 가라앉았다가 “시공의 균열”과 함께 떠오른 신대륙 아스테라를 무대로 한 오리지널 스토리 팬게임입니다. 설치 없이 브라우저에서 바로 플레이합니다.</p>
                <div class="facts"><span class="status"><span class="dot"></span>운영 중</span><span>2026</span><span>비영리 팬게임</span></div>
            </section>

            <!-- 실제 서비스 화면 (브라우저 창 틀) -->
            <figure class="shot">
                <div class="frame">
                    <div class="chrome" aria-hidden="true"><i><b></b><b></b><b></b></i><span>domang.org/pokemon</span></div>
                    <img class="pixel" src="/img/shots/pokemon.jpg" alt="포켓몬스터 아스테라 불씨마을 게임 화면" width="960" height="600" />
                </div>
                <figcaption>불씨마을 (실제 게임 화면). 1~9세대 포켓몬과 전설·환상 포켓몬이 사는 대륙을 탐험하며 8개 체육관과 포켓몬리그에 도전합니다.</figcaption>
            </figure>

            <!-- 주요 기능 -->
            <section class="block">
                <h2>주요 기능</h2>
                <div>
                    <ul class="feats">
                        <li><h3>오리지널 스토리와 대륙</h3><p>체육관 8곳, 악당 조직 균열단, 사천왕과 챔피언, 엔딩 후 균열 지대와 배틀 타워까지. 챕터 카드와 모험 수첩이 다음 목표를 알려줍니다.</p></li>
                        <li><h3>세대별 배틀 기믹</h3><p>메가진화, 다이맥스·거다이맥스, 테라스탈, Z기술, 원시회귀를 지원합니다. 맥스 레이드와 테라 레이드 둥지도 있습니다.</p></li>
                        <li><h3>포켓몬 1025종 + 폼 438종</h3><p>지역 폼과 메가·거다이맥스 폼을 포함한 도감, 특성 310종, 기술 920개. 동료 포켓몬이 뒤를 따라 걷습니다.</p></li>
                        <li><h3>회원 서버 저장</h3><p>domang.org 회원으로 로그인하면 기록과 키 설정이 계정에 저장되어 다른 기기에서도 이어서 할 수 있습니다.</p></li>
                        <li><h3>PC · 모바일 지원</h3><p>키보드 키 설정, 배속(1~8배), 위치를 옮길 수 있는 모바일 가상 컨트롤러를 지원합니다.</p></li>
                    </ul>
                </div>
            </section>

            <!-- 광고: 본문 중간 (버튼·링크와 떨어진 자리) -->
            <div class="ad-mid"><partial name="_AdUnit" model='@("inline")' /></div>

            <!-- 출현 정보 (확률 요약 + 접힌 지역별 표) -->
            <section class="block">
                <h2>출현 정보</h2>
                <div>
            <!-- ENCOUNTERS:START (자동 생성: 게임 데이터에서 뽑은 출현 정보) -->
        <div class="enc-rules">
            <div class="enc-rule"><span>풀숲 야생 조우</span><p>풀숲에서 한 걸음마다 <b>9%</b></p></div>
            <div class="enc-rule"><span>배회 전설</span><p>배지 5개 이후 풀숲 한 걸음마다 <b>약 0.45%</b> (1/220) · 엔테이, 라이코, 스이쿤, 라티아스, 라티오스, 토네로스, 볼트로스, 파이어, 썬더, 프리져, 크레세리아</p></div>
            <div class="enc-rule"><span>환상의 풀숲</span><p>조우 1번당 <b>3%</b>가 전설·환상 125종 중 무작위(각 약 0.024%), 97%는 일반 900종 중 무작위(각 약 0.108%) · Lv.40~60</p></div>
            <div class="enc-rule"><span>필드 전설·환상</span><p>맵에 서 있는 전설에게 말을 걸면 <b>100%</b> 전투 (조건이 있는 경우 조건을 만족해야 함) · 쓰러뜨려도 다시 나타남</p></div>
            <div class="enc-rule"><span>이로치</span><p>야생 <b>1/512</b> (빛나는부적 1/128) · 필드 전설 1/100 · 레이드 1/200</p></div>
        </div>
        <details class="enc-all">
                <summary>지역별 레벨·출현 포켓몬 보기 <em>21곳</em></summary>
                <div class="enc-list">
            <details class="enc-map">
                <summary><b>1번도로</b><em>Lv.2~5</em></summary>
                <div class="enc-h">풀숲 야생 (조우 1번당 확률)</div><div class="chips"><span class="chip">구구 <i>19.6%</i></span><span class="chip">꼬렛 <i>19.6%</i></span><span class="chip">꼬리선 <i>11.8%</i></span><span class="chip">비버니 <i>11.8%</i></span><span class="chip">요테리 <i>9.8%</i></span><span class="chip">영구스 <i>7.8%</i></span><span class="chip">탐리스 <i>7.8%</i></span><span class="chip">맛보돈 <i>5.9%</i></span><span class="chip">화살꼬빈 <i>2.9%</i></span><span class="chip">우르 <i>2.9%</i></span></div>
            </details>
            <details class="enc-map">
                <summary><b>2번도로</b><em>Lv.5~9</em></summary>
                <div class="enc-h">풀숲 야생 (조우 1번당 확률)</div><div class="chips"><span class="chip">캐터피 <i>12%</i></span><span class="chip">뿔충이 <i>12%</i></span><span class="chip">니드런♀ <i>10%</i></span><span class="chip">니드런♂ <i>10%</i></span><span class="chip">보르쥐 <i>10%</i></span><span class="chip">포챠나 <i>10%</i></span><span class="chip">지그제구리 <i>10%</i></span><span class="chip">찌르꼬 <i>9%</i></span><span class="chip">꼬링크 <i>8%</i></span><span class="chip">피카츄 <i>4%</i></span><span class="chip">랄토스 <i>3%</i></span><span class="chip">이브이 <i>2%</i></span></div>
            </details>
            <details class="enc-map">
                <summary><b>초록숲</b><em>Lv.7~12 · 전설·환상 1 · 레이드 1</em></summary>
                <div class="enc-h">풀숲 야생 (조우 1번당 확률)</div><div class="chips"><span class="chip">캐터피 <i>10%</i></span><span class="chip">뿔충이 <i>10%</i></span><span class="chip">단데기 <i>8%</i></span><span class="chip">딱충이 <i>8%</i></span><span class="chip">뚜벅쵸 <i>8%</i></span><span class="chip">파라스 <i>7%</i></span><span class="chip">콘팡 <i>7%</i></span><span class="chip">부우부 <i>7%</i></span><span class="chip">꼬몽울 <i>6%</i></span><span class="chip">두르보 <i>6%</i></span><span class="chip">피카츄 <i>5%</i></span><span class="chip">콩알뚜기 <i>5%</i></span><span class="chip">메이클 <i>5%</i></span><span class="chip">짜랑랑 <i>4%</i></span><span class="chip">치릴리 <i>4%</i></span></div>
                <div class="enc-h">필드의 전설·환상 (말 걸면 전투)</div><ul class="enc-lg">
                    <li><span class="k myth">환상</span><b>세레비</b> Lv.40<small>오래된 사당이다. &quot;시간을 넘는 방울&quot;을 바치는 자리가 있다... (GS볼 필요)</small></li>
                </ul>
                <div class="enc-h">레이드</div><p class="enc-p">맥스 레이드 둥지 · 매일 출현 포켓몬이 바뀜 (맥스 레이드는 배지 5개, 테라 레이드는 배지 6개부터)</p>
            </details>
            <details class="enc-map">
                <summary><b>3번도로</b><em>Lv.13~19 · 레이드 1</em></summary>
                <div class="enc-h">풀숲 야생 (조우 1번당 확률)</div><div class="chips"><span class="chip">가디 <i>8.2%</i></span><span class="chip">포니타 <i>8.2%</i></span><span class="chip">알통몬 <i>8.2%</i></span><span class="chip">꼬마돌 <i>8.2%</i></span><span class="chip">메리프 <i>8.2%</i></span><span class="chip">식스테일 <i>7.1%</i></span><span class="chip">델빌 <i>7.1%</i></span><span class="chip">캐이시 <i>6.1%</i></span><span class="chip">암멍이 <i>6.1%</i></span><span class="chip">마크탕 <i>6.1%</i></span><span class="chip">썬더라이 <i>6.1%</i></span><span class="chip">블루 <i>6.1%</i></span><span class="chip">빠모 <i>5.1%</i></span><span class="chip">어리짱 <i>4.1%</i></span><span class="chip">미뇽 <i>2%</i></span><span class="chip">아공이 <i>1%</i></span><span class="chip">딥상어동 <i>1%</i></span><span class="chip">모노두 <i>1%</i></span></div>
                <div class="enc-h">레이드</div><p class="enc-p">테라 레이드 결정 · 매일 출현 포켓몬이 바뀜 (맥스 레이드는 배지 5개, 테라 레이드는 배지 6개부터)</p>
            </details>
