@page "/metaindex"
@model MetaIndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meta Search — 구글·네이버·다음·Brave 통합 검색엔진 | domang</title>
    <meta name="description" content="구글·네이버·다음·Brave 검색 결과를 한 번에 모아 순위를 다시 매기는 통합 검색엔진 Meta Search 소개. 인기 검색어, 실시간 트렌드, AI 추천 검색어와 검색 품질 평가 리포트를 제공합니다." />
    <!-- 검색엔진·공유 미리보기: 대표 주소 / Open Graph / 트위터 카드 / 구조화 데이터 -->
    <link rel="canonical" href="https://domang.org/metaindex" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="domang" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content="https://domang.org/metaindex" />
    <meta property="og:title" content="Meta Search — 구글·네이버·다음·Brave 통합 검색엔진 | domang" />
    <meta property="og:description" content="구글·네이버·다음·Brave 검색 결과를 한 번에 모아 순위를 다시 매기는 통합 검색엔진 Meta Search 소개. 인기 검색어, 실시간 트렌드, AI 추천 검색어와 검색 품질 평가 리포트를 제공합니다." />
    <meta property="og:image" content="https://domang.org/img/og/metasearch.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Meta Search — 구글·네이버·다음·Brave 통합 검색엔진 | domang" />
    <meta name="twitter:description" content="구글·네이버·다음·Brave 검색 결과를 한 번에 모아 순위를 다시 매기는 통합 검색엔진 Meta Search 소개. 인기 검색어, 실시간 트렌드, AI 추천 검색어와 검색 품질 평가 리포트를 제공합니다." />
    <meta name="twitter:image" content="https://domang.org/img/og/metasearch.jpg" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebApplication",
      "name": "Meta Search",
      "url": "https://domang.org/metasearch",
      "applicationCategory": "SearchApplication",
      "operatingSystem": "Web",
      "inLanguage": "ko",
      "author": {
        "@@type": "Person",
        "name": "안도영",
        "url": "https://domang.org/",
        "sameAs": [
          "https://github.com/andomang"
        ]
      },
      "description": "구글·네이버·다음·Brave 검색 결과를 한 번에 모아 순위를 다시 매기는 통합 검색엔진 Meta Search 소개. 인기 검색어, 실시간 트렌드, AI 추천 검색어와 검색 품질 평가 리포트를 제공합니다.",
      "image": "https://domang.org/img/og/metasearch.jpg"
    }
    </script>
    <!-- 파비콘 -->
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- 테마: 저장된 선택이 있으면 그리기 전에 바로 적용 (깜빡임 방지). 없으면 기기 설정을 따름 -->
    <script>
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <!-- 본문 글꼴: Pretendard (메인 포트폴리오와 같음) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <!-- 소개 페이지 공통 스타일 (흰 바탕 편집 디자인, 다크 모드 포함) -->
    <link rel="stylesheet" href="/css/project.css" asp-append-version="true" />
    <!-- 구글 애드센스 (설정에 게시자 ID가 있을 때만, 제외 경로 제외) -->
    <partial name="_AdHead" />
</head>
<body class="p-meta">
    <script>document.documentElement.classList.add('js');</script>
    <!-- 광고: 넓은 화면(1290px 이상)에서 본문 양옆 고정 -->
    <aside class="ad-side ad-left" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <aside class="ad-side ad-right" aria-label="광고"><partial name="_AdUnit" model='@("side")' /></aside>
    <div class="wrap">
        <!-- 상단: 포트폴리오로 / 테마 전환 / 바로가기 -->
        <header class="topbar">
            <a href="/" class="back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>domang.org</a>
            <div class="top-actions">
                <button type="button" class="theme-btn" id="themeBtn" aria-label="다크 모드로 바꾸기">
                    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </button>
                <a href="/metasearch" class="go">Meta Search 열기<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
            </div>
        </header>

        <main>
            <!-- 첫 화면: 제목 / 한 문단 / 상태 -->
            <section class="hero">
                <h1>Meta Search</h1>
                <p class="lede">구글·네이버·다음·Brave를 한 번에 검색하고, 네 엔진의 결과를 하나의 순위로 합쳐 보여 주는 통합 검색엔진입니다.</p>
                <div class="facts"><span class="status"><span class="dot"></span>운영 중</span><span>2026</span><span>domang.org/metasearch</span></div>
            </section>

            <!-- 실제 서비스 화면 (브라우저 창 틀) -->
            <figure class="shot">
                <div class="frame">
                    <div class="chrome" aria-hidden="true"><i><b></b><b></b><b></b></i><span>domang.org/metasearch</span></div>
                    <img src="/img/shots/metasearch.jpg" alt="Meta Search 검색 첫 화면" width="960" height="600" />
                </div>
                <figcaption>Meta Search 첫 화면 (실제 서비스 캡처)</figcaption>
            </figure>

            <!-- 주요 기능 -->
            <section class="block">
                <h2>주요 기능</h2>
                <div>
                    <ul class="feats">
                        <li><h3>4대 엔진 통합 검색</h3><p>Google, Naver, Daum, Brave 4개 검색엔진을 병렬로 크롤링하여 RRF(Reciprocal Rank Fusion) 알고리즘으로 결합합니다.</p></li>
                        <li><h3>AI 결과 재정렬</h3><p>Claude AI가 검색 의도를 분석하고, 결과의 관련성을 평가하여 최적 순서로 재정렬합니다. 관련 검색어도 자동 추천합니다.</p></li>
                        <li><h3>개인화 엔진 가중치</h3><p>사용자의 클릭 패턴과 검색 키워드 분야에 따라 엔진별 가중치가 자동으로 조정되어 점점 더 나은 결과를 제공합니다.</p></li>
                        <li><h3>인기검색어 TOP10 &amp; 트렌드</h3><p>실시간 인기검색어 순위와 트렌드를 DB 캐싱으로 빠르게 제공합니다. 자동완성 검색어 추천도 지원합니다.</p></li>
                    </ul>
                </div>
            </section>

            <!-- 광고: 본문 중간 (버튼·링크와 떨어진 자리) -->
            <div class="ad-mid"><partial name="_AdUnit" model='@("inline")' /></div>

            <!-- 기술 -->
            <section class="block">
                <h2>기술</h2>
                <div>
                    <table class="stack">
                        <tr><th scope="row">서버</th><td>ASP.NET Core 8 · Razor Pages</td></tr>
                        <tr><th scope="row">데이터</th><td>PostgreSQL · Dapper</td></tr>
                        <tr><th scope="row">AI</th><td>Claude API</td></tr>
                        <tr><th scope="row">화면</th><td>Tailwind CSS</td></tr>
                        <tr><th scope="row">운영</th><td>Raspberry Pi 4 · Nginx · Cloudflare Tunnel</td></tr>
                    </table>
                </div>
            </section>

            <!-- 광고: 본문 끝(기술 소개)과 '열기' 버튼 구역 사이 — 링크·버튼에 붙지 않게 위아래 여백 + 구분선 -->
            <div class="ad-mid"><partial name="_AdUnit" model='@("inline")' /></div>
            <!-- 직접 써 보기 -->
            <section class="cta">
                <p>직접 검색해 보세요.</p>
                <a href="/metasearch" class="go big">Meta Search 열기<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
            </section>

            <!-- 다른 프로젝트로 바로 이동 -->
            <nav class="others" aria-label="다른 프로젝트">
                <h2>다른 프로젝트</h2>
                <ul>
                    <li><a href="/pokeindex"><b>포켓몬스터 아스테라</b><span>브라우저 팬게임<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a></li>
                    <li><a href="/driveindex"><b>Cloud Drive</b><span>개인 클라우드 드라이브<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a></li>
                    <li><a href="/ottindex"><b>OTT Multi-View</b><span>Windows 데스크톱 앱<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></a></li>
                </ul>
            </nav>

        </main>

        <!-- 연락처 & 저작권 -->
        <footer class="fine">
            <span>&copy; 2026 안도영 · <a href="mailto:metasearch@@domang.org">metasearch@@domang.org</a> · 010-2583-1894</span>
            <a href="/Privacy" class="u">개인정보처리방침</a>
        </footer>
    </div>
    <script src="/js/theme.js" asp-append-version="true"></script>
</body>
</html>
