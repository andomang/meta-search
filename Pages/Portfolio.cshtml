    <script>
        // ── 운영 구조도: 화면에 처음 들어올 때 한 번만 요청 흐름 연출 (선·글자는 처음부터 다 보임) ──
        (function () {
            var flow = document.getElementById('flow');
            if (!('IntersectionObserver' in window)) return;
            var io = new IntersectionObserver(function (es) {
                if (es[0].isIntersecting) { flow.classList.add('run'); io.disconnect(); }
            }, { threshold: .6 });
            io.observe(flow);
        })();

        // ── 프로젝트 줄에 마우스를 올리면 실제 화면 미리보기가 커서를 부드럽게 따라옴 (마우스가 있는 넓은 화면만) ──
        (function () {
            if (!matchMedia('(hover: hover) and (pointer: fine) and (min-width: 641px)').matches) return;
            var peek = document.getElementById('peek'), img = peek.querySelector('img');
            var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
            var x = 0, y = 0, tx = 0, ty = 0, raf = 0;
            var tick = function () {
                x += (tx - x) * (still ? 1 : .16); y += (ty - y) * (still ? 1 : .16);
                peek.style.left = x + 'px'; peek.style.top = y + 'px';
                raf = Math.abs(tx - x) + Math.abs(ty - y) > .5 ? requestAnimationFrame(tick) : 0;
            };
            document.querySelectorAll('.row a[data-shot]').forEach(function (a) {
                a.addEventListener('mouseenter', function (e) {
                    img.src = a.dataset.shot; img.className = a.dataset.pixel ? 'pixel' : '';
                    tx = x = e.clientX + 200; ty = y = e.clientY;
                    peek.style.left = x + 'px'; peek.style.top = y + 'px';
                    peek.classList.add('on');
                });
                a.addEventListener('mousemove', function (e) { tx = e.clientX + 200; ty = e.clientY; if (!raf) raf = requestAnimationFrame(tick); });
                a.addEventListener('mouseleave', function () { peek.classList.remove('on'); });
            });
        })();

        // ── 로그인 상태: 로그인 중이면 닉네임 + 로그아웃 (관리자는 아스테라 관리 링크) ──
        fetch('/api/pokemon/me', { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (me) {
            if (!me.loggedIn) return;
            var bar = document.getElementById('authBar'), name = me.nick || me.userId;
            bar.innerHTML = (me.isAdmin ? '<a href="/admin" class="auth-link">관리자</a>' : '') +
                '<span class="auth-name"></span><button type="button" class="auth-btn" id="authOut">로그아웃</button>';
            bar.querySelector('.auth-name').textContent = name + ' 님';
            document.getElementById('authOut').addEventListener('click', function () {
                fetch('/api/astera/logout', { method: 'POST', credentials: 'same-origin' }).then(function () { location.reload(); });
            });
        }).catch(function () { });
    </script>
