    <!-- 파비콘 -->
    <link rel="icon" href="/icons/icon-512.png" type="image/png" />
    <!-- 테마: 저장된 선택이 있으면 그리기 전에 바로 적용 (깜빡임 방지). 없으면 기기 설정을 따름 -->
    <script>
        try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) { }
    </script>
    <!-- 본문 글꼴: Pretendard (한글·영문 모두 고르게, 필요한 글자만 나눠 받음) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

    <style>
        /* ── 색 (라이트 기본) ── 흰 종이에 먹색 글자, 강조색은 주홍 한 가지만 */
        :root {
            --paper: #ffffff;
            --ink: #15161a;
            --ink-2: #4c5058;
            --ink-3: #6b7079;
            --rule: #e7e5e0;
            --rule-strong: #15161a;
            --accent: #d9480f;
            --live: #2f9e44;
            --tint: #f6f5f2;
            --shadow: 0 18px 40px -12px rgba(21, 22, 26, .28), 0 4px 10px -4px rgba(21, 22, 26, .12);
            color-scheme: light;
        }
        /* 다크: 기기 설정(직접 고르지 않았을 때) */
        @@media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                --paper: #0f1012; --ink: #ecebe7; --ink-2: #b4b6bb; --ink-3: #8d9097;
                --rule: #26282d; --rule-strong: #ecebe7; --accent: #ff7a3d; --live: #51cf66; --tint: #17181b;
                --shadow: 0 18px 40px -12px rgba(0, 0, 0, .7), 0 4px 10px -4px rgba(0, 0, 0, .5);
                color-scheme: dark;
            }
        }
        /* 다크: 버튼으로 직접 고름 */
        :root[data-theme="dark"] {
            --paper: #0f1012; --ink: #ecebe7; --ink-2: #b4b6bb; --ink-3: #8d9097;
            --rule: #26282d; --rule-strong: #ecebe7; --accent: #ff7a3d; --live: #51cf66; --tint: #17181b;
            --shadow: 0 18px 40px -12px rgba(0, 0, 0, .7), 0 4px 10px -4px rgba(0, 0, 0, .5);
            color-scheme: dark;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { -webkit-text-size-adjust: 100%; }
        body {
            background: var(--paper); color: var(--ink);
            font-family: "Pretendard Variable", Pretendard, -apple-system, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
            font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased;
            word-break: keep-all; overflow-wrap: break-word;   /* 한글을 낱말 단위로 줄바꿈 ('만/들고'처럼 끊기지 않게) */
            transition: background-color .35s ease, color .35s ease;
        }
        ::selection { background: var(--accent); color: #fff; }
        a { color: inherit; text-decoration: none; }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
        html { scrollbar-color: var(--ink-3) var(--paper); }

        .wrap { max-width: 880px; margin: 0 auto; padding-inline: 24px; }

        /* ── 상단 줄: 사이트 이름 / 테마 / 로그인 ── */
        .topbar {
            display: flex; align-items: center; justify-content: space-between; gap: 16px;
            padding-block: calc(20px + env(safe-area-inset-top, 0px)) 20px;
            font-size: 14px;
        }
        .wordmark { font-weight: 700; letter-spacing: -0.01em; }
        .top-actions { display: flex; align-items: center; gap: 10px; }
        .auth-bar { display: flex; align-items: center; gap: 10px; }
        .auth-name { color: var(--ink-2); }
        .auth-link { color: var(--accent); }
        .auth-link:hover { text-decoration: underline; text-underline-offset: 3px; }
        .auth-btn, .theme-btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 6px;
            height: 34px; padding: 0 14px; border-radius: 999px;
            border: 1px solid var(--rule); background: var(--paper); color: var(--ink);
            font: inherit; font-size: 13px; font-weight: 600; cursor: pointer;
            transition: border-color .2s ease, background-color .2s ease;
        }
        .auth-btn:hover, .theme-btn:hover { border-color: var(--ink); }
        .theme-btn { width: 34px; padding: 0; }
        .theme-btn svg { width: 16px; height: 16px; }
        .theme-btn .i-moon { display: none; }
        :root[data-theme="dark"] .theme-btn .i-sun { display: none; }
        :root[data-theme="dark"] .theme-btn .i-moon { display: block; }
        @@media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) .theme-btn .i-sun { display: none; }
            :root:not([data-theme="light"]) .theme-btn .i-moon { display: block; }
        }

        /* ── 첫 화면: 이름과 한 문장 ── */
        .hero { padding-block: clamp(56px, 12vw, 128px) clamp(40px, 7vw, 72px); }
        .hero h1 {
            font-size: clamp(3.5rem, 13vw, 6rem); line-height: .95; font-weight: 800; letter-spacing: -0.04em;
        }
        .hero h1 .name { display: inline-block; }
        .lede {
            margin-top: 28px; max-width: 30ch;
            font-size: clamp(1.25rem, 2.6vw, 1.6rem); line-height: 1.45; font-weight: 500; letter-spacing: -0.02em;
            color: var(--ink); text-wrap: balance;
        }
        .lede em { font-style: normal; color: var(--accent); }
        .hero-links { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 28px; font-size: 15px; color: var(--ink-2); }
        .hero-links a { display: inline-flex; align-items: center; gap: 6px; }
        .hero-links a span { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .35s cubic-bezier(.16, 1, .3, 1); padding-bottom: 1px; }
        .hero-links a:hover { color: var(--ink); }
        .hero-links a:hover span { background-size: 100% 1px; }
        .hero-links svg { width: 16px; height: 16px; }

        /* ── 프로젝트 목록: 굵은 선으로 시작하는 인덱스 ── */
        .index { border-top: 2px solid var(--rule-strong); list-style: none; }
        .row { border-bottom: 1px solid var(--rule); }
        .row a {
            display: grid; grid-template-columns: 3.2rem 1fr auto; column-gap: 16px; row-gap: 6px; align-items: baseline;
            padding: 26px 4px; position: relative;
        }
        .num { font-size: 14px; color: var(--ink-3); font-variant-numeric: tabular-nums; transition: color .25s ease; }
        .title {
            font-size: clamp(1.4rem, 3.4vw, 2rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.2;
            justify-self: start;
            background: linear-gradient(var(--ink), var(--ink)) 0 100% / 0 2px no-repeat; padding-bottom: 2px;
            transition: background-size .5s cubic-bezier(.16, 1, .3, 1);
        }
        .meta { display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--ink-2); white-space: nowrap; }
        .status { display: inline-flex; align-items: center; gap: 7px; }
        .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--live); box-shadow: 0 0 0 0 var(--live); }
        .dot.off { background: var(--ink-3); animation: none; }
        @@keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--live) 55%, transparent); } 70%, 100% { box-shadow: 0 0 0 7px transparent; } }
        .arrow { width: 18px; height: 18px; color: var(--ink-3); transition: transform .35s cubic-bezier(.16, 1, .3, 1), color .2s ease; }
        .desc { grid-column: 2 / 4; color: var(--ink-2); font-size: 15px; max-width: 62ch; }
        .stack { grid-column: 2 / 4; font-size: 13px; color: var(--ink-3); }
        .stack span + span::before { content: "/"; margin: 0 8px; opacity: .5; }
        .thumb { display: none; }
        /* '열기' 버튼: 소개 페이지를 거치지 않고 바로 서비스로 (이용자용)
           줄을 [링크 | 버튼] 두 칸으로 나누고 첫 줄 글자 기준선(baseline)에 맞춰 '운영 중 2026 →' 바로 옆에 놓음 */
        .row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; column-gap: 10px; }
        .row .open {
            display: inline-flex; align-items: center; height: 30px; padding: 0 14px; border-radius: 999px;
            border: 1px solid var(--ink); font-size: 13px; font-weight: 700; color: var(--ink); background: var(--paper);
            transition: background-color .2s ease, color .2s ease, border-color .2s ease;
        }
        .row .open:hover, .row .open:focus-visible { background: var(--accent); border-color: var(--accent); color: #fff; }
        .ad-mid { margin-top: 48px; }
        .ad-mid:empty { display: none; }
        .row a:hover .title, .row a:focus-visible .title { background-size: 100% 2px; }
        .row a:hover .num, .row a:focus-visible .num { color: var(--accent); }
        .row a:hover .dot:not(.off), .row a:focus-visible .dot:not(.off) { animation: pulse 1.6s ease-out 2; }   /* 운영 중 표시는 마우스를 올렸을 때만 두 번 깜빡 (계속 깜빡이면 산만함) */
        .row a:hover .arrow, .row a:focus-visible .arrow { transform: translateX(5px); color: var(--ink); }

        /* 마우스를 올린 프로젝트의 실제 화면이 커서를 따라다님 (넓은 화면 + 마우스일 때만) */
        .peek {
            position: fixed; left: 0; top: 0; z-index: 20; pointer-events: none;
            width: 360px; aspect-ratio: 16 / 10; border-radius: 10px; overflow: hidden;
            box-shadow: var(--shadow); background: var(--tint);
            opacity: 0; transform: translate3d(-50%, -50%, 0) scale(.86); filter: blur(6px);
            transition: opacity .3s ease, filter .35s ease, scale .45s cubic-bezier(.16, 1, .3, 1);
            scale: .92;
        }
        .peek.on { opacity: 1; filter: blur(0); scale: 1; }
        .peek img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
        .peek img.pixel { image-rendering: pixelated; object-position: center; }

        /* ── 운영 구조도: 방문자 → Cloudflare → 라즈베리파이 (→ 외부 API) ── */
        .ops { padding-block: 80px 8px; display: grid; gap: 28px; }
        .ops h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.15; }
        .ops-lede { color: var(--ink-2); max-width: 52ch; margin-top: -12px; }
        .flow { display: grid; grid-template-columns: 1fr 44px 1fr 44px 1.7fr; align-items: center; }
        .node { border: 1px solid var(--rule); border-radius: 10px; padding: 16px 18px; background: var(--paper); transition: border-color .4s ease, box-shadow .4s ease; }
        .node > b { display: block; font-size: 15px; font-weight: 700; letter-spacing: -0.01em; }
        .node > span { display: block; font-size: 13px; color: var(--ink-3); margin-top: 2px; }
        .node.pi { border: 2px solid var(--rule-strong); }
        .node.pi ul { list-style: none; margin-top: 10px; }
        .node.pi li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; padding-block: 8px; border-top: 1px solid var(--rule); font-size: 14px; }
        .node.pi li b { font-weight: 700; }
        .node.pi li span { color: var(--ink-3); font-size: 13px; }
        /* 연결선: 가는 선 + 끝 화살표 (넓은 화면은 가로, 좁은 화면은 세로) */
        .link { position: relative; height: 1px; background: var(--ink-3); margin-inline: 6px; }
        .link::before { content: ""; position: absolute; right: -1px; top: -4px; border: 4.5px solid transparent; border-left: 6px solid var(--ink-3); border-right: 0; }
        .link i { position: absolute; left: 0; top: -3px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); opacity: 0; }
        .out { display: grid; grid-template-columns: 1fr 44px 1fr 44px 1.7fr; }
        .out .vlink { grid-column: 5; justify-self: center; width: 1px; height: 28px; background: var(--ink-3); position: relative; }
        .out .vlink::before { content: ""; position: absolute; bottom: -1px; left: -4px; border: 4.5px solid transparent; border-top: 6px solid var(--ink-3); border-bottom: 0; }
        .out .node { grid-column: 5; }
        .ops-note { font-size: 13px; color: var(--ink-3); }
        /* 처음 화면에 들어올 때 한 번: 요청 점이 방문자에서 서버까지 흘러가고, 도착한 칸 테두리가 잠깐 강조색 */
        @@media (prefers-reduced-motion: no-preference) {
            .flow.run .link i { animation: packet .7s cubic-bezier(.45, 0, .2, 1) both; }
            /* nth-of-type은 태그별 순번: 칸(div) 1·2·3, 선(span) 1·2 */
            .flow.run .link:nth-of-type(2) i { animation-delay: .7s; }
            .flow.run .node { animation: ping 1.2s ease both; }
            .flow.run .node:nth-of-type(2) { animation-delay: .65s; }
            .flow.run .node:nth-of-type(3) { animation-delay: 1.35s; }
        }
        @@keyframes packet { 0% { left: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { left: calc(100% - 7px); opacity: 0; } }
        @@keyframes ping { 0%, 100% { border-color: var(--rule); } 30% { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent); } }
        .node.pi { animation-name: none; }
        .flow.run .node.pi { animation-name: ping-pi; }
        @@keyframes ping-pi { 0%, 100% { border-color: var(--rule-strong); } 30% { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent); } }

        /* ── 아래: 연락처 ── */
        .contact { padding-block: 72px 24px; display: grid; gap: 24px; }
        .contact h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.15; max-width: 18ch; }
        .contact-lines { display: flex; flex-wrap: wrap; gap: 10px 28px; font-size: 15px; color: var(--ink-2); }
        .contact-lines a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
        .fine { border-top: 1px solid var(--rule); margin-top: 48px; padding-block: 20px calc(28px + env(safe-area-inset-bottom, 0px)); font-size: 12.5px; color: var(--ink-3); display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: space-between; }
        .fine a { text-decoration: underline; text-underline-offset: 3px; }

        /* ── 광고 자리 ── 본문(880px) 양옆 160px. 들어갈 자리가 있을 때만 */
        .ad-side { position: fixed; top: 96px; width: 160px; z-index: 5; display: none; }
        .ad-left { left: calc(50% - 440px - 200px); }
        .ad-right { right: calc(50% - 440px - 200px); }
        .ad-side:empty { display: none !important; }
        /* 폭과 높이 둘 다 될 때만 (낮은 노트북 화면에서 600px 광고 아래가 잘리지 않게) */
        @@media (min-width: 1290px) and (min-height: 760px) { .ad-side { display: block; } }

        /* ── 첫 등장: 이름이 아래에서 밀려 올라오고 목록이 차례로 (한 번만) ── */
        @@media (prefers-reduced-motion: no-preference) {
            .js .hero h1 .name { animation: rise .9s cubic-bezier(.16, 1, .3, 1) both; clip-path: inset(0 0 0 0); }
            .js .lede, .js .hero-links { animation: fade .8s .18s cubic-bezier(.16, 1, .3, 1) both; }
            .js .row { animation: fade .7s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(.32s + var(--i) * .07s); }
        }
        @@keyframes rise { from { transform: translateY(.35em); opacity: 0; filter: blur(8px); } to { transform: none; opacity: 1; filter: blur(0); } }
        @@keyframes fade { from { transform: translateY(14px); opacity: 0; } to { transform: none; opacity: 1; } }
        @@media (prefers-reduced-motion: reduce) { .dot { animation: none; } * { transition-duration: .01ms !important; } }

        /* ── 좁은 화면 ── */
        @@media (max-width: 640px) {
            .wrap { padding-inline: 16px; }
            .row a { grid-template-columns: 2.2rem 1fr auto; column-gap: 10px; padding: 22px 0; }
            .row { column-gap: 6px; }
            .meta .year { display: none; }
            .desc, .stack { grid-column: 2 / 4; }
            .thumb { display: block; grid-column: 2 / 4; margin-top: 8px; border-radius: 8px; overflow: hidden; border: 1px solid var(--rule); aspect-ratio: 16 / 9; }
            .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
            .thumb img.pixel { image-rendering: pixelated; object-position: center; }
            .auth-name { display: none; }
            /* 구조도: 세로로 쌓고 연결선도 세로 */
            .ops { padding-block: 56px 8px; }
            .flow, .out { grid-template-columns: 1fr; }
